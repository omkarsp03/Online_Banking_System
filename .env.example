# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=online_banking
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# JWT Configuration
# Change this to a secure 256-bit secret key in production
JWT_SECRET=your-jwt-secret

# Encryption Config
# 16-byte key represented as a 32-character hexadecimal string
AES_SECRET=your-aes-secret

# Email Configuration (Phase 3)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
